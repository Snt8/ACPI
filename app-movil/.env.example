# Copiar a .env (no se sube a git) y completar. Ver docs/servidor-api.md.
# URL del servidor web de ACPI en Render, sin barra final
EXPO_PUBLIC_API_URL=https://acpi.onrender.com
# Token que el servidor exige para escribir eventos (vacío si no pide ninguno).
# Queda dentro de la app: no puede servir para leer ni borrar datos
EXPO_PUBLIC_API_TOKEN=
