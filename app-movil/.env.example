# Copiar a .env (no se sube a git) y completar. Ver docs/grafana-setup.md.
# Grafana Cloud → tu stack → Loki → "Details":
EXPO_PUBLIC_LOKI_URL=https://logs-prod-XXX.grafana.net
# El "User" de Loki (un número)
EXPO_PUBLIC_LOKI_USUARIO=
# Token de una access policy que SÓLO tenga el permiso logs:write: queda dentro de la app
EXPO_PUBLIC_LOKI_TOKEN=
